{
  "name": "website-asset-validator-mern",
  "version": "1.0.0",
  "description": "Website Asset Validator (MERN)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm install && npm run build && cd ../server && npm install",
    "start": "node server/src/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "crawlee": "^3.17.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "p-limit": "^7.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}

