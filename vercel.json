{
  "$schema": "https://vercel.com/schema/v2.json",
  "version": 2,

  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    { "src": "/api/(.*)", "dest": "/server/src/index.js" },
    { "src": "/(.*)", "dest": "/client/dist/$1" }
  ],

  "env": {
    "PORT": "5000",
    "MAX_DEPTH": "5",
    "CONCURRENCY": "10"
  }
}
